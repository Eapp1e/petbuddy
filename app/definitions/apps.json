[
  {
    "id": "claude",
    "name": "Claude Code",
    "emoji": "✳️",
    "color": "#d97757",
    "processNames": [
      "claude.exe"
    ],
    "ports": [],
    "site": "claude.ai",
    "markers": [
      "~/.claude/settings.json",
      "~/.claude/projects",
      "~/.claude.json"
    ],
    "integration": [
      {
        "style": "claude-file",
        "path": "~/.claude/settings.json",
        "eventCase": "pascal",
        "standalone": false
      }
    ],
    "note": "写入 ~/.claude/settings.json 的 hooks 键"
  },
