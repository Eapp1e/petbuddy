  {
    "id": "qoder",
    "name": "Qoder",
    "emoji": "🧠",
    "color": "#615ced",
    "processNames": [
      "Qoder.exe"
    ],
    "ports": [],
    "site": "qoder.com",
    "markers": [
      "~/.qoder",
      "%APPDATA%/Qoder"
    ],
    "integration": [
      {
        "style": "none"
      }
    ],
    "note": "镜像模式",
    "activity": {
      "roots": [
        "~/.qoder/logs/sessions",
        "~/.qoder/logs/runs"
      ],
      "glob": "**/*",
      "tsField": "ts",
      "gapMs": 600000,
      "presenceFreshMs": 240000,
      "journal": {
        "typePath": "type",
        "typeValue": "tool.requested",
        "namePath": "data.tool_name",
        "detailPath": "data.args.command",
        "prompt": {
          "typeValue": "input.prompt.submitted",
          "textPath": "data.text_preview"
        },
        "turnStart": {
          "typeValue": "turn.started"
        },
        "presenceValues": [
          "tool.requested",
          "model.request.started",
          "model.response.completed",
          "loop.iteration.started",
          "loop.iteration.finished"
        ]
      }
    }
  },
