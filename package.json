{
  "name": "petbuddy",
  "version": "0.1.0",
  "description": "PetBuddy 🐾 — unified Windows desktop pet for ZCode / Codex / WorkBuddy / DSH: task status at a glance, approve permission requests right on the pet.",
  "main": "app/main.js",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "start-hidden": "electron . --hidden",
    "install-integrations": "node integrations/install.mjs install",
    "uninstall-integrations": "node integrations/install.mjs uninstall"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^24.13.3"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Eapp1e/petbuddy.git"
  },
  "keywords": [
    "electron",
    "desktop-pet",
    "ai-agent",
    "claude",
    "codex",
    "workbuddy",
    "status-monitor"
  ],
  "author": "EAPPLE",
  "build": {
    "appId": "dev.eapple.petbuddy",
    "productName": "PetBuddy",
    "directories": {
      "output": "release"
    },
    "files": [
      "app/**/*",
      "package.json"
    ],
    "asar": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "PetBuddy-Setup-${version}.${ext}",
      "createDesktopShortcut": true,
      "shortcutName": "PetBuddy"
    },
    "electronDist": "node_modules/electron/dist",
    "portable": {
      "artifactName": "PetBuddy-${version}-portable.${ext}"
    }
  }
}
